[Unit]
Description=AdGuard Home 局域网DNS
After=network-online.target mosdns.service
Wants=network-online.target mosdns.service

[Service]
Type=simple
WorkingDirectory=/var/lib/adguardhome
ExecStart=/usr/local/bin/AdGuardHome -c /etc/bypass-router/adguardhome/AdGuardHome.yaml -w /var/lib/adguardhome --no-check-update
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/bypass-router/adguardhome /var/lib/adguardhome
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
