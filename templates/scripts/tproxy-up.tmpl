#!/usr/bin/env bash
set -euo pipefail
NFT_FILE=/etc/bypass-router/nftables/tproxy.nft
TABLE={{ROUTE_TABLE}}
MARK={{FWMARK}}
PREF={{ROUTE_PRIORITY}}
WAIT_SECONDS=35
log(){ printf '[tproxy-up] %s\n' "$*" >&2; }
rollback(){ nft delete table inet bypass_router 2>/dev/null||true;while ip -4 rule del fwmark "$MARK" table "$TABLE" priority "$PREF" 2>/dev/null;do :;done;ip -4 route flush table "$TABLE" 2>/dev/null||true;}
port_ready(){ local proto=$1 port=$2;if [[ $proto == tcp ]];then ss -H -lnt;else ss -H -lnu;fi|grep -qE "(^|[[:space:]])([^[:space:]]*:)?${port}([[:space:]]|$)";}
ready(){ systemctl is-active --quiet mihomo.service&&systemctl is-active --quiet adguardhome.service&&port_ready tcp {{MIHOMO_REDIR_PORT}}&&port_ready udp {{MIHOMO_TPROXY_PORT}}&&port_ready tcp 53&&port_ready udp 53;}
trap rollback ERR
stable=0
for ((i=1;i<=WAIT_SECONDS;i++));do
 if ready;then stable=$((stable+1));((stable>=2))&&break;else stable=0;fi
 ((i==WAIT_SECONDS))&&{ log '等待依赖端口超时';exit 1;};sleep 1
done
nft -c -f "$NFT_FILE";rollback
ip -4 route replace local 0.0.0.0/0 dev lo table "$TABLE"
ip -4 rule add fwmark "$MARK" table "$TABLE" priority "$PREF"
nft -f "$NFT_FILE"
nft list table inet bypass_router >/dev/null
ip -4 rule show priority "$PREF"|grep -q "lookup $TABLE"
ip -4 route show table "$TABLE"|grep -q 'local default dev lo'
trap - ERR
log '透明代理已就绪'
