#!/opt/bypass-router-web/venv/bin/python
from __future__ import annotations
import argparse, hashlib, ipaddress, json, os, shutil, socket, subprocess, sys, tempfile, time
import urllib.error, urllib.parse, urllib.request
from pathlib import Path
import yaml

URL_FILE=Path('/etc/bypass-router/mihomo/secrets/provider-url')
PROVIDER=Path('/var/lib/mihomo/providers/main.yaml')
BACKUPS=Path('/var/lib/mihomo/subscription-backups')
CANDIDATES=Path('/var/lib/mihomo/subscription-candidates')
STATE=Path('/var/lib/mihomo/providers/main.state.json')
PREFERRED=Path('/etc/bypass-router/mihomo/preferred-node.json')

def validate_url(url):
    u=urllib.parse.urlparse(url)
    if u.scheme!='https' or not u.hostname or u.username or u.password:
        raise ValueError('只允许不含用户名密码的HTTPS订阅URL')
    return u

def safe_url(url):
    u=validate_url(url)
    for info in socket.getaddrinfo(u.hostname,u.port or 443,type=socket.SOCK_STREAM):
        ip=ipaddress.ip_address(info[4][0].split('%')[0])
        if ip.is_loopback or ip.is_private or ip.is_link_local or ip.is_multicast or ip.is_reserved or ip.is_unspecified:
            raise ValueError('订阅地址解析到禁止的内网或保留地址')
    return u

class SafeRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,req,fp,code,msg,headers,newurl):
        safe_url(urllib.parse.urljoin(req.full_url,newurl))
        return super().redirect_request(req,fp,code,msg,headers,newurl)

def preferred_order(raw):
    d=yaml.safe_load(raw);proxies=d.get('proxies') if isinstance(d,dict) else None
    if not isinstance(proxies,list):return raw
    try:preferred=json.loads(PREFERRED.read_text()).get('preferred')
    except Exception:preferred=None
    if preferred:
        first=[x for x in proxies if x.get('name')==preferred]
        if first:d['proxies']=first+[x for x in proxies if x.get('name')!=preferred]
    return yaml.safe_dump(d,allow_unicode=True,sort_keys=False).encode()

def fetch(url):
    safe_url(url)
    try: current=yaml.safe_load(PROVIDER.read_text()) if PROVIDER.exists() else {}
    except Exception: current={}
    proxy=urllib.request.ProxyHandler({'http':'http://127.0.0.1:7890','https':'http://127.0.0.1:7890'} if (current or {}).get('proxies') else {})
    op=urllib.request.build_opener(proxy,SafeRedirect())
    req=urllib.request.Request(url,headers={'User-Agent':'clash.meta','Accept':'*/*'})
    with op.open(req,timeout=35) as r:
        if int(r.headers.get('Content-Length','0') or 0)>10_000_000: raise ValueError('订阅文件过大')
        raw=r.read(10_000_001)
    if len(raw)>10_000_000: raise ValueError('订阅文件过大')
    return raw

def parse(raw):
    d=yaml.safe_load(raw)
    proxies=d.get('proxies') if isinstance(d,dict) else None
    if not isinstance(proxies,list) or not proxies: raise ValueError('订阅未返回有效proxies')
    names=[]
    for x in proxies:
        if not isinstance(x,dict) or not x.get('name') or not x.get('type'): raise ValueError('存在无效节点')
        names.append(str(x['name']))
    if len(names)!=len(set(names)): raise ValueError('节点名称重复')
    return names

def current_names():
    try:return parse(PROVIDER.read_bytes())
    except Exception:return []

def mask(u):
    return {'host':u.hostname,'scheme':'https','path_hint':(u.path[:24]+'…') if len(u.path)>24 else u.path,'configured':True}

def preview(url):
    u=safe_url(url); raw=preferred_order(fetch(url)); names=parse(raw); old=current_names()
    token=hashlib.sha256(raw+os.urandom(16)).hexdigest()[:32]
    CANDIDATES.mkdir(parents=True,exist_ok=True); os.chmod(CANDIDATES,0o700)
    (CANDIDATES/(token+'.yaml')).write_bytes(raw); os.chmod(CANDIDATES/(token+'.yaml'),0o600)
    meta={'token':token,'created':time.time(),'url':url,'host':u.hostname,'new_count':len(names),'old_count':len(old),'added':sorted(set(names)-set(old))[:30],'removed':sorted(set(old)-set(names))[:30],'unchanged':len(set(old)&set(names))}
    (CANDIDATES/(token+'.json')).write_text(json.dumps(meta,ensure_ascii=False));os.chmod(CANDIDATES/(token+'.json'),0o600)
    return {k:v for k,v in meta.items() if k not in {'url','created'}}

def apply(token):
    if not token or not all(c in '0123456789abcdef' for c in token) or len(token)!=32: raise ValueError('无效确认令牌')
    mf=CANDIDATES/(token+'.json'); pf=CANDIDATES/(token+'.yaml')
    meta=json.loads(mf.read_text());
    if time.time()-meta['created']>600: raise ValueError('预检已过期，请重新预检')
    raw=pf.read_bytes(); names=parse(raw); validate_url(meta['url'])
    BACKUPS.mkdir(parents=True,exist_ok=True); os.chmod(BACKUPS,0o700); stamp=time.strftime('%Y%m%d-%H%M%S'); b=BACKUPS/stamp; b.mkdir(mode=0o700)
    if URL_FILE.exists(): shutil.copy2(URL_FILE,b/'provider-url')
    if PROVIDER.exists(): shutil.copy2(PROVIDER,b/'main.yaml')
    def atomic(path,data):
        fd,tmp=tempfile.mkstemp(prefix='.'+path.name+'.',dir=str(path.parent));os.close(fd);Path(tmp).write_bytes(data);os.chmod(tmp,0o600);os.replace(tmp,path)
    try:
        atomic(URL_FILE,(meta['url']+'\n').encode()); atomic(PROVIDER,raw)
        r=subprocess.run(['curl','-fsS','-X','PUT','http://127.0.0.1:9090/providers/proxies/main'],timeout=15,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        if r.returncode: raise RuntimeError('Mihomo重新加载Provider失败')
        time.sleep(2)
        r=subprocess.run(['curl','-4','-sS','-x','http://127.0.0.1:7890','--max-time','12','-o','/dev/null','-w','%{http_code}','https://www.google.com'],text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
        if r.returncode or not r.stdout.startswith(('2','3')): raise RuntimeError('Google验证失败')
        STATE.write_text(json.dumps({'ok':True,'proxy_count':len(names),'subscription_host':meta['host']},ensure_ascii=False)+'\n');os.chmod(STATE,0o600)
    except Exception:
        if (b/'provider-url').exists(): shutil.copy2(b/'provider-url',URL_FILE)
        if (b/'main.yaml').exists(): shutil.copy2(b/'main.yaml',PROVIDER)
        subprocess.run(['curl','-fsS','-X','PUT','http://127.0.0.1:9090/providers/proxies/main'],timeout=15)
        raise
    finally:
        pf.unlink(missing_ok=True);mf.unlink(missing_ok=True)
    return {'ok':True,'proxy_count':len(names),'host':meta['host'],'backup':stamp}

def status():
    try:u=validate_url(URL_FILE.read_text().strip()); info=mask(u)
    except Exception:info={'configured':False}
    info['proxy_count']=len(current_names()); return info

ap=argparse.ArgumentParser();sub=ap.add_subparsers(dest='cmd',required=True)
sub.add_parser('status');p=sub.add_parser('preview');p.add_argument('--url',required=True);a=sub.add_parser('apply');a.add_argument('--token',required=True)
args=ap.parse_args()
try:
    result=status() if args.cmd=='status' else preview(args.url) if args.cmd=='preview' else apply(args.token)
    print(json.dumps(result,ensure_ascii=False))
except Exception as e:
    print(json.dumps({'ok':False,'error':str(e)},ensure_ascii=False));sys.exit(1)
